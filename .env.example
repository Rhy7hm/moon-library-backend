# Moon Library backend — copy to .env and fill in. Never commit .env.
# Every value can also come from the real environment (systemd, CloudPanel); those win over .env.
# This project must use its OWN database and bucket: it refuses to start on the M2 library's
# (DB m2library / m2analytics / m2win-api, bucket m2-library / m2win).

# ---------------------------------------------------------------- app
# production | development | test
APP_ENV=development
# Long random string (e.g. `python -c "import secrets; print(secrets.token_urlsafe(48))"`). Required in production.
SECRET_KEY=

# ---------------------------------------------------------------- MySQL (same engine locally and in production)
# Your own MySQL. start.sh checks these and asks for them if they don't work.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=moon_library
DB_USER=root
# Any characters are fine (@ : / # % …) — the connection address is built safely from these parts.
DB_PASSWORD=

# ---------------------------------------------------------------- Cloudflare R2 (the files themselves)
# R2 → Manage R2 API tokens → Create API token (Object Read & Write, this bucket only).
# Endpoint: the bucket's "S3 API" address without the bucket name, https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ENDPOINT_URL=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=moon-library
R2_REGION=auto
# Keep EMPTY: the bucket stays private and files go through this app (/f/…), which checks the
# staff sign-in. A public R2 domain here would bypass that.
ASSET_BASE=

# ---------------------------------------------------------------- accounts
# Needed once, to create the first Owner on the /admin setup page (only while there are no accounts).
# Or create the first Owner from the command line instead:  flask --app wsgi create-owner
SETUP_KEY=
# On your own computer: create the first Owner on the /admin page without SETUP_KEY (ignored in production).
ALLOW_SETUP_WITHOUT_KEY=1
# Optional, 24+ characters: lets scripts call the admin API with "Authorization: Bearer <token>".
# Leave empty to turn this off.
ADMIN_API_TOKEN=
# Name of the sign-in cookie (keep different from any other app on the same domain).
# SESSION_COOKIE=moonlib_session

# ---------------------------------------------------------------- addresses and proxies
# How many reverse proxies sit in front (their X-Forwarded-* headers are trusted for the client IP,
# https and the host name). Production default 1 (nginx); 0 when nothing is in front (local development).
# TRUST_PROXY_HOPS=1
# Other origins allowed to send changes to the admin API, comma-separated (normally not needed:
# the Vite dev server forwards the browser's host). Example: http://localhost:5173
# ALLOWED_ORIGINS=
# Force Secure cookies even outside production (they're always Secure when APP_ENV=production)
# COOKIE_SECURE=1

# ---------------------------------------------------------------- Google Drive backup (optional)
# Two ways — see docs/google-drive-backup.md.
#
# A) A personal Google Drive (Gmail + Google One): the OAuth client from Google Cloud Console.
#    Then an Owner presses "Connect Google Drive" in Settings → Connections.
GDRIVE_CLIENT_ID=
GDRIVE_CLIENT_SECRET=
#    The client's redirect URI must be https://<this site>/api/admin/drive/callback (worked out
#    from the request; set it here only if the site sits behind something that changes the address)
# GDRIVE_REDIRECT_URL=
#
# B) A Google Workspace Shared drive and a service account ("robot"). Off unless BOTH are set.
GDRIVE_FOLDER_ID=
GDRIVE_SA_FILE=
# … or paste the whole JSON on one line instead:
# GDRIVE_SA_JSON=

# ---------------------------------------------------------------- tuning (optional)
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=10
# Where the built admin panel is (default: admin/dist next to this file)
# ADMIN_DIST=
