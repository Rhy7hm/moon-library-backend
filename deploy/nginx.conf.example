# Moon Library: the client website, the staff admin and their API, all on one domain.
#   https://library.moon-interactive.com/        sign in (everyone) + the client website
#   https://library.moon-interactive.com/admin   the staff admin (staff are sent here after signing in)
#   /api/…, /f/…, /zip                            the API and file downloads
# Everything goes to Gunicorn on 127.0.0.1:8100. DNS: one A record, "library" → this server's IP.

upstream moonlib_backend { server 127.0.0.1:8100; keepalive 16; }

server {
    listen 443 ssl http2;
    server_name library.moon-interactive.com;
    # ssl_certificate / ssl_certificate_key: managed by CloudPanel (Let's Encrypt) or certbot

    # uploads: the admin and the client site send at most 20 MB per request (10 MB parts for bigger files)
    client_max_body_size 100m;

    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_set_header Host $http_host;
    proxy_set_header X-Forwarded-Host $http_host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Real-IP $remote_addr;

    location ~ ^/api/(admin|client)/upload$ {
        proxy_pass http://moonlib_backend;
        proxy_request_buffering off;      # stream upload bodies straight through
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }
    # files and ZIPs: streamed, never buffered to disk by nginx; Range requests pass through
    location /f/   { proxy_pass http://moonlib_backend; proxy_buffering off; proxy_read_timeout 600s; }
    location = /zip { proxy_pass http://moonlib_backend; proxy_buffering off; proxy_read_timeout 3600s; }
    location /     { proxy_pass http://moonlib_backend; proxy_read_timeout 300s; }
}

server {
    listen 80;
    server_name library.moon-interactive.com;
    return 301 https://$host$request_uri;
}

# Matching .env:  APP_ENV=production, TRUST_PROXY_HOPS=1.
